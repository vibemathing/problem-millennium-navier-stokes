    {
      "obligation_id": "obligation:ns-local-lemma-root-20260930",
      "kind": "root_claim",
      "statement": {
        "text": "For every nu>0, every smooth solution (u,p,f) of the viscosity-1 incompressible Navier-Stokes equations on an open spatial domain Omega times an interval I transforms to a viscosity-nu solution on sqrt(nu) Omega times I by u_nu(x,t)=sqrt(nu)u(x/sqrt(nu),t), p_nu(x,t)=nu p(x/sqrt(nu),t), f_nu(x,t)=sqrt(nu)f(x/sqrt(nu),t). When the spatial L2 norm is finite, its square scales by nu^(5/2). This conditional local transformation neither constructs blowup nor closes any Clay branch.",
        "language": "en",
        "formal_declaration": null
      },
      "statement_sha256": "b7860f5f1a4aa3a3b7c38709f6742bbb62f87c2701f1283efab8b4f8e1c1a3cc",
      "dependencies": [

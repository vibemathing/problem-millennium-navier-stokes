    {
      "obligation_id": "obligation:ns-local-lemma-chain-20260930",
      "kind": "lemma",
      "statement": {
        "text": "Under the root assumptions, the transformed PDE residual is sqrt(nu) times the original residual at x/sqrt(nu), and div_x u_nu equals div_y u. Verify every chain-rule factor for arbitrary nu>0; nu=0 is excluded.",
        "language": "en",
        "formal_declaration": null
      },
